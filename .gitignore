# Build output — regenerate with `python build.py` (Cloudflare Pages runs it too)
dist/
dist-local/
__pycache__/
*.pyc

# Credentials. Never commit these, and never copy them into dist/.
gsc-service-account*.json
gsc-oauth-token*.json
ddc-seo-*.json
.env
.env.*

# Local secrets (server access, scratch notes). Never commit.
.local/

# Local preview artefacts / screenshots (reproducible, not source)
preview/*.png
*.local

# wrangler local cache (created by `wrangler pages deploy`)
.wrangler/

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
